# Django
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# PostgreSQL
POSTGRES_DB=omnichat
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024

# Embeddings
EMBEDDING_PROVIDER=ollama

# Hugging Face embeddings
HF_TOKEN=
HF_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HF_EMBEDDING_DIMENSIONS=1024

# AI
AI_PROVIDER=freellmapi
AI_MODEL=auto
AI_CONTEXT_MAX_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1024
AI_KNOWLEDGE_TOP_K=5

# FreeLLMAPI
FREELLMAPI_BASE_URL=http://host.docker.internal:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_READ_TIMEOUT=25.0

# Knowledge
KNOWLEDGE_MAX_FILE_SIZE=10485760
KNOWLEDGE_SEARCH_MAX_DISTANCE=0.50

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
